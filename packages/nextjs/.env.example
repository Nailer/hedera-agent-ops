# From https://cloud.walletconnect.com — the bundled fallback id is shared and rate-limited.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# JSON-RPC relays. Defaults are Hashio's public endpoints.
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Mirror node REST base used to replay the audit trail.
# Defaults to https://testnet.mirrornode.hedera.com — point this at mainnet, or at your own
# mirror node, to verify the trail without trusting the endpoint this template picked.
NEXT_PUBLIC_MIRROR_NODE_URL=
